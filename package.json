{
  "name": "ghostsearch",
  "version": "1.0.0",
  "description": "Sub-millisecond client-side full-text search engine. Zero server. Replaces Algolia.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.mjs",
      "require": "./dist/node.js"
    },
    "./worker-script": {
      "import": "./dist/worker-script.mjs",
      "require": "./dist/worker-script.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "bench": "node benchmarks/run.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "search",
    "full-text",
    "client-side",
    "browser",
    "offline",
    "algolia-alternative",
    "ghostsearch"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "Soumya Debnath <soumyadebnath1661@gmail.com>",
  "dependencies": {
    "flexsearch": "^0.7.31"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "COMMERCIAL_LICENSE.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsoumya-d/ghostsearch.git"
  },
  "homepage": "https://itsoumya-d.github.io/ghostsearch/",
  "bugs": {
    "url": "https://github.com/itsoumya-d/ghostsearch/issues"
  },
  "browser": {
    "fs": false
  }
}
